{
  "default_rules": {
    "group_by": ["name", "color", "cable_type"],
    "description": "默认规则：NAME、COLOR、CABLE_TYPE 相同则合并"
  },
  "custom_rules": [
    {
      "name": "jump_wires",
      "condition": {
        "field": "name",
        "operator": "contains",
        "value": "JUMP"
      },
      "group_by": ["name"],
      "description": "NAME 包含 'JUMP' 的导线自动合并",
      "priority": 10
    }
  ],
  "required_fields": ["WIRE_ID", "NAME", "NODE_A", "NODE_B", "COLOR", "CABLE_TYPE"]
}
